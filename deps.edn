{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        org.datalevin/datalevin-embedded {:mvn/version "1.2.2"}}
 :aliases
 {:run {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"
                   "-Xmx512m"]
        :main-opts ["-m" "leak"]}}}
